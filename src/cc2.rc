// Crash Course 2 - Windows resources.
// MAINICON is the name the runtime's window class loads
// (src/ui/window_win.cpp: LoadIconW(hinstance, L"MAINICON")), and the first
// icon resource is also what Explorer/taskbar show for the exe.
// The VERSIONINFO FileDescription is the display name Task Manager uses.

MAINICON ICON "icon.ico"

1 VERSIONINFO
FILEVERSION 2,0,0,0
PRODUCTVERSION 2,0,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "Crash Course 2: Recompiled"
      VALUE "ProductName", "Crash Course 2: Recompiled"
      VALUE "FileVersion", "2.0.0.0"
      VALUE "ProductVersion", "2.0.0"
      VALUE "InternalName", "cc2"
      VALUE "OriginalFilename", "crashcourse2.exe"
      VALUE "CompanyName", "JMstudios"
      VALUE "LegalCopyright", "All trademarks and copyrights are property of their respective owners."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
